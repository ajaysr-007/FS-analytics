{
    "type": "AdaptiveCard",
    "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "body": [
        {
            "type": "TextBlock",
            "text": "status: ${if(status, status, 'N/A')}",
            "wrap": true
        },
        {
            "type": "Container",
            "$data": "${group_by}",
            "items": [
                {
                    "type": "TextBlock",
                    "text": "group_by: ${$data}",
                    "wrap": true
                }
            ]
        },
        {
            "type": "TextBlock",
            "text": "date_granularity: ${if(date_granularity, date_granularity, 'N/A')}",
            "wrap": true
        },
        {
            "type": "Container",
            "$data": "${breakdown}",
            "items": []
        }
    ]
}
